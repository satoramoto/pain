# Copy to .env. Image digests can replace tags for exact reproducibility.
PAIN_ROCM_IMAGE=ollama/ollama:0.40.13-rocm
PAIN_VULKAN_IMAGE=ollama/ollama:0.40.13
# Defaults to ~/Models; use an absolute path to override.
# PAIN_MODELS_DIR=/absolute/path/to/Models
PAIN_PORT=11434
PAIN_CONTEXT_LENGTH=65536
PAIN_KV_CACHE_TYPE=f16
PAIN_KEEP_ALIVE=30m
PAIN_LLAMACPP_CPU_IMAGE=ghcr.io/ggml-org/llama.cpp:server
PAIN_LLAMACPP_VULKAN_IMAGE=ghcr.io/ggml-org/llama.cpp:server-vulkan
# Training lab. Code dir is mounted at /workspace/code inside the container.
PAIN_LAB_CODE=/home/ryan/Projects/ryangavin/scalespace/swarms/track_b_tools
PAIN_LAB_EXPERIMENTS=/home/ryan/Projects/satoramoto/pain/experiments
PAIN_LAB_THREADS=8
PAIN_LAB_SEED=0
# Container engine: docker (default) or podman. Stop PAIN before switching.
PAIN_RUNTIME=docker
# Experimental Mac Metal through VirtGPU: see docs/macos.md.

# Linux ComfyUI (separate from the LLM model store and port).
# Defaults use the invoking user's home even with sudo.
# PAIN_COMFYUI_DATA_DIR=/home/your-user/.local/share/pain/comfyui
PAIN_COMFYUI_PORT=8188
# Optional image overrides; the default ROCm image targets Strix Halo (gfx1151).
# PAIN_COMFYUI_ROCM_IMAGE=registry/your-comfyui-rocm:tag
# PAIN_COMFYUI_CUDA_IMAGE=registry/your-comfyui-cuda:tag
# PAIN_COMFYUI_ARGS=--reserve-vram 4
