#!/usr/bin/env python3
"""Link this checkout into Omarchy once; no copying or reinstalling during dev."""
import datetime
import os
from pathlib import Path
import shutil
import subprocess

source = Path(__file__).resolve().parent / 'pain'
subprocess.run(['node', str(source.parents[2] / 'scripts/prepare-ui.mjs')], check=True)
config = Path(os.environ.get('XDG_CONFIG_HOME', str(Path.home() / '.config')))
target = config / 'omarchy/plugins/local.pain'
subprocess.run(['omarchy', 'plugin', 'validate', str(source)], check=True)
if target.is_symlink() and target.resolve() == source:
    pass
elif target.exists() or target.is_symlink():
    raise SystemExit(f'Refusing to replace existing plugin: {target}')
else:
    target.parent.mkdir(parents=True, exist_ok=True)
    target.symlink_to(source, target_is_directory=True)
shell_config = config / 'omarchy/shell.json'
if shell_config.exists():
    stamp = datetime.datetime.now().strftime('%Y%m%d-%H%M%S-%f')
    shutil.copy2(shell_config, shell_config.with_name(f'shell.json.pain-backup-{stamp}'))
subprocess.run(['omarchy-shell', 'shell', 'rescanPlugins'], check=True)
subprocess.run(['omarchy', 'plugin', 'enable', 'local.pain', '--section', 'right'], check=True)
print(f'pain(less) linked to {source}. Edit this checkout directly.')
