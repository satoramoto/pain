#!/bin/sh
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
. "$root/integrations/macos/common.sh"
pain_require_runtime
if ! podman machine inspect pain-metal >/dev/null 2>&1; then
  podman machine init --cpus "${PAIN_VM_CPUS:-4}" --memory "${PAIN_VM_MEMORY:-8192}" \
    --disk-size "${PAIN_VM_DISK:-60}" pain-metal
fi
"$root/integrations/macos/start-machine"
printf 'pain(less) VM is ready. Start inference with: %s/integrations/macos/ai up llamacpp-metal\n' "$root"
