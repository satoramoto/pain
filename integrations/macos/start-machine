#!/bin/sh
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
. "$root/integrations/macos/common.sh"
pain_require_runtime
if [ "$(podman machine inspect pain-metal --format '{{.State}}')" = running ]; then
  echo 'pain-metal is already running. Stop it before changing runtime versions.'
  exit 0
fi
exec podman machine start pain-metal
