#!/bin/bash
# Rebuild the current checkout and replace the local QA app, keeping inference running.
set -euo pipefail
root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
destination=${1:-/Applications/PAIN.app}
if [ "$#" -gt 1 ] || [[ "$destination" != /*/PAIN.app ]]; then
  echo 'Usage: integrations/macos/rebuild-install [/absolute/path/PAIN.app]' >&2
  exit 1
fi
[ "$(uname -s):$(uname -m)" = Darwin:arm64 ] || { echo 'Requires an Apple Silicon Mac.' >&2; exit 1; }
for tool in npm cargo codesign ditto; do
  command -v "$tool" >/dev/null || { echo "Missing build tool: $tool" >&2; exit 1; }
done
for artifact in pain-macos-runtime-arm64.tar.gz pain-macos-runtime-arm64.tar.gz.sha256; do
  [ -f "$root/.build/$artifact" ] || {
    echo 'Build or download the matching runtime into .build first; see docs/macos.md.' >&2
    exit 1
  }
done
(cd "$root/.build" && shasum -a 256 -c pain-macos-runtime-arm64.tar.gz.sha256)
archive="$root/.build/pain-macos-runtime-arm64.tar.gz"
if [ "$(tar -xOf "$archive" macos-runtime/llama-revision)" != "$(cat "$root/containers/virtgpu/llama-revision")" ] ||
   [ "$(tar -xOf "$archive" macos-runtime/virgl-revision)" != "$(cat "$root/integrations/macos/virgl-revision")" ]; then
  echo 'Cached runtime revisions do not match this checkout; rebuild the runtime first.' >&2
  exit 1
fi
if [ ! -d "$root/desktop/node_modules" ]; then
  npm --prefix "$root/desktop" ci
fi
npm --prefix "$root/desktop" run stage
target=${CARGO_TARGET_DIR:-$root/desktop/src-tauri/target}
if [[ "$target" != /* ]]; then target="$root/desktop/src-tauri/$target"; fi
export CARGO_TARGET_DIR="$target"
# An app bundle is enough for local QA; skip the distribution DMG.
npm --prefix "$root/desktop" run tauri build -- --target aarch64-apple-darwin --bundles app --no-sign
app="$target/aarch64-apple-darwin/release/bundle/macos/PAIN.app"
[ -x "$app/Contents/MacOS/pain-desktop" ] || { echo "Missing built app: $app" >&2; exit 1; }
# Local QA needs a complete ad-hoc bundle signature, not just rustc's linker signature.
codesign --force --sign - "$app"
codesign --verify --deep --strict "$app"

mkdir -p "$HOME/.syns/scratch/pain" "$(dirname -- "$destination")"
stage=$(mktemp -d "$HOME/.syns/scratch/pain/rebuild-install.XXXXXX")
installed=false
replaced=false
cleanup() {
  local result=$?
  if [ "$installed" = false ] && [ "$replaced" = true ]; then
    mv "$destination" "$stage/PAIN.app" || {
      echo "The previous app is preserved at $stage/previous.app" >&2
      return 1
    }
  fi
  if [ "$installed" = false ] && [ -d "$stage/previous.app" ]; then
    if [ ! -e "$destination" ]; then
      mv "$stage/previous.app" "$destination" || {
        echo "Restore the previous app from $stage/previous.app" >&2
        return 1
      }
    else
      echo "The previous app is preserved at $stage/previous.app" >&2
      return 1
    fi
  fi
  rm -rf -- "$stage"
  return "$result"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
ditto "$app" "$stage/PAIN.app"
codesign --verify --deep --strict "$stage/PAIN.app"
# Quitting PAIN's window/tray does not stop its VM or inference containers.
if pgrep -x pain-desktop >/dev/null; then
  osascript -e 'tell application id "ai.pain.desktop" to quit'
fi
if pgrep -x pain-desktop >/dev/null; then
  echo 'Quit PAIN before replacing the app, then rerun this command.' >&2
  exit 1
fi
if [ -e "$destination" ]; then mv "$destination" "$stage/previous.app"; fi
mv "$stage/PAIN.app" "$destination"
replaced=true
codesign --verify --deep --strict "$destination"
installed=true
printf 'Installed %s\nOpen it for QA: open "%s"\n' "$destination" "$destination"
