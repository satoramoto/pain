{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "pain(less)",
  "version": "0.1.0",
  "identifier": "ai.pain.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "pain(less)",
        "width": 460,
        "height": 850,
        "visible": false,
        "resizable": false,
        "decorations": false,
        "skipTaskbar": true,
        "transparent": true,
        "windowEffects": {
          "effects": [
            "hudWindow"
          ],
          "state": "active"
        }
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "resources": {
      "resources/payload/": "payload/",
      "resources/runtime/": "runtime/"
    },
    "macOS": {
      "minimumSystemVersion": "15.0"
    },
    "createUpdaterArtifacts": false
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": [
        "https://github.com/satoramoto/pain/releases/latest/download/latest.json"
      ]
    }
  }
}
