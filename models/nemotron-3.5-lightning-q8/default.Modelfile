# NVIDIA Nemotron 3.5 Lightning 30B-A3B (Q8_0, 3B active parameters)
# Source: https://huggingface.co/unsloth/NVIDIA-Nemotron-3.5-Lightning-30B-A3B-GGUF
# Download: https://huggingface.co/unsloth/NVIDIA-Nemotron-3.5-Lightning-30B-A3B-GGUF/resolve/main/NVIDIA-Nemotron-3.5-Lightning-30B-A3B-Q8_0.gguf 35004643392
# 35,004,643,392 bytes of weights (~32.6 GiB); built for always-on agent loops.
# Fetch into PAIN_MODELS_DIR before restarting; the router skips missing files.
FROM /models/NVIDIA-Nemotron-3.5-Lightning-30B-A3B-Q8_0.gguf
PARAMETER num_ctx 131072
PARAMETER num_batch 512
PARAMETER num_thread 8
PARAMETER num_predict 8192
# Publisher sampling (model card): temperature 1.0, top_p 0.95.
# Disable extra default filtering/penalties for the Ollama backend.
PARAMETER temperature 1.0
PARAMETER top_p 0.95
PARAMETER top_k 0
PARAMETER min_p 0
PARAMETER repeat_penalty 1
PARAMETER presence_penalty 0
