ROOT = Path(__file__).resolve().parent
STATE = ROOT / '.state' / 'backend'
CONTAINER_STATE = ROOT / '.state' / 'container.json'
RUNTIME_STATE = ROOT / '.state' / 'runtime'
BACKENDS = ('rocm', 'vulkan', 'llamacpp-vulkan', 'llamacpp-cpu', 'llamacpp-metal')


def config():
    values = {}
    path = ROOT / '.env'
    if path.exists():
        for line in path.read_text().splitlines():
            line = line.strip()
            if line and not line.startswith('#'):
                key, sep, value = line.partition('=')
                if not sep:
                    raise ValueError(f'Invalid .env line: {line}')
                values[key.strip()] = value.strip().strip('"\'')
    values.update(os.environ)
    return values


def backend():
    name = STATE.read_text().strip() if STATE.exists() else 'rocm'
    if name not in BACKENDS:
        raise ValueError(f'Invalid saved backend: {name}')
    return name


def runtime():
    name = config().get('PAIN_RUNTIME', 'docker')
    if name not in ('docker', 'podman'):
        raise ValueError('PAIN_RUNTIME must be docker or podman.')
    return name


def compose(*args, selected=None, capture=False):
    selected = selected or backend()
    if args and args[0] not in ('config', 'build', 'pull') and RUNTIME_STATE.exists():
        previous = RUNTIME_STATE.read_text().strip()
        if previous != runtime():
            raise ValueError(f'PAIN belongs to {previous}. Run PAIN_RUNTIME={previous} ./ai down before switching runtimes.')
    env = config()
    env['PAIN_BACKEND'] = selected
    env['PAIN_MODELS_DIR'] = str(models_dir())
    command = [runtime(), 'compose',
               '-f', str(ROOT / 'compose.yaml'),
               '-f', str(ROOT / 'backends' / f'{selected}.yaml'), *args]
    return subprocess.run(command, cwd=ROOT, env=env, check=True, text=True,
                          stdout=subprocess.PIPE if capture else None,
                          stderr=subprocess.DEVNULL if capture else None)


def api(path, data=None, timeout=1800):
    port = int(config().get('PAIN_PORT', '11434'))
    payload = json.dumps(data).encode() if data is not None else None
    request = urllib.request.Request(f'http://127.0.0.1:{port}/api/{path}',
                                     data=payload,
                                     headers={'Content-Type': 'application/json'})
    try:
        with urllib.request.urlopen(request, timeout=timeout) as response:
            result = json.load(response)
    except urllib.error.HTTPError as exc:
        body = exc.read().decode('utf-8', 'replace')
        try:
            msg = json.loads(body).get('error') or body
        except ValueError:
            msg = body or str(exc)
        raise ValueError(f'/api/{path}: {msg}') from exc
    if 'error' in result:
        raise ValueError(result['error'])
    return result


def container():
    try:
        cid = compose('ps', '-q', capture=True).stdout.strip()
        if not cid:
            raise ValueError('PAIN is not running. Start it with ./ai up <backend>.')
        details = json.loads(subprocess.check_output([runtime(), 'inspect', cid], text=True))[0]
    except (OSError, subprocess.CalledProcessError) as exc:
        try:
            port = int(config().get('PAIN_PORT', '11434'))
            check_url = f'http://127.0.0.1:{port}/health' if backend().startswith('llamacpp') else f'http://127.0.0.1:{port}/api/version'
            req = urllib.request.Request(check_url)
            with urllib.request.urlopen(req, timeout=3) as res:
                pass
        except Exception:
            raise ValueError('PAIN is not running. Start it with ./ai up <backend>.') from exc
        if CONTAINER_STATE.exists():
            details = json.loads(CONTAINER_STATE.read_text())
        else:
            details = {'Image': 'unknown', 'Config': {'Image': 'unknown', 'Env': [],
                                                      'Labels': {'ai.pain.backend': backend()}}}
    actual = details['Config'].get('Labels', {}).get('ai.pain.backend')
    if actual != backend():
        raise ValueError('Container/backend mismatch; run ./ai up with the desired backend.')
    return details


def up(name):
    # Ensure the models directory exists
    models_dir()
    # Pull/validate before replacing the working service. One Compose project means
    # switching backends replaces the same service instead of running two engines.
    compose('config', selected=name, capture=True)
    if name == 'llamacpp-metal':
        if runtime() != 'podman':
            raise ValueError('llamacpp-metal requires Podman with an APIR-enabled libkrun VM. See docs/macos.md.')
        compose('build', 'engine', selected=name)
        # Probe the actual remoted device before replacing a working engine.
        compose('run', '-T', '--rm', '--no-deps', 'engine', '--pain-probe', selected=name)
    else:
        compose('pull', 'engine', selected=name)
    if name.startswith('llamacpp'):
        # llama-server reads models.ini once at startup, so the presets must be
        # current before the container is (re)created, not after it is healthy.
        generate_models_ini()
    compose('up', '-d', '--force-recreate', '--remove-orphans', 'engine', selected=name)
    STATE.parent.mkdir(exist_ok=True)
    STATE.write_text(name + '\n')
    RUNTIME_STATE.write_text(runtime() + '\n')
    details = container()
    CONTAINER_STATE.write_text(json.dumps(details))
    deadline = time.monotonic() + 90
    if name.startswith('llamacpp'):
        port = int(config().get('PAIN_PORT', '11434'))
        while time.monotonic() < deadline:
            try:
                req = urllib.request.Request(f'http://127.0.0.1:{port}/health')
                with urllib.request.urlopen(req, timeout=3) as res:
                    if res.status == 200:
                        break
            except (urllib.error.URLError, TimeoutError, ConnectionError, OSError):
                time.sleep(1)
                continue
        else:
            raise ValueError(f'llama-server on port {port} not ready after 90 seconds. Inspect ./ai logs.')
        sync_opencode()
        print(f'PAIN ready: {name}, llama.cpp server, localhost:{port}')
    else:
        while time.monotonic() < deadline:
            try:
                version = api('version', timeout=3)['version']
            except (urllib.error.URLError, TimeoutError, ConnectionError, OSError):
                time.sleep(1)
                continue
            break
        else:
            raise ValueError('API not ready after 90 seconds. Inspect ./ai logs.')
        for preset, path in presets().items():
            if not preset_ready(path):
                print(f'Skipping preset (weights not on disk): {preset}', flush=True)
                continue
            print(f'Applying preset: {preset}', flush=True)
            apply(preset)
        sync_opencode()
        print(f'PAIN ready: {name}, Ollama {version}, localhost:{config().get("PAIN_PORT", "11434")}')
        print('All presets applied. Open OpenCode and select a model with /models.')



def presets():
    return {f'{p.parent.name}-{p.stem}': p
            for p in sorted((ROOT / 'models').glob('*/*.Modelfile'))}


def models_dir():
    cfg = config()
    raw = cfg.get('PAIN_MODELS_DIR') or cfg.get('PAIN_HOT_DIR') or str(Path.home() / 'Models')
    path = Path(raw).expanduser().resolve()
    path.mkdir(parents=True, exist_ok=True)
    return path


def preset_ready(path):
    """False when a local FROM file is missing; remote tags pull on demand."""
    root = models_dir()
    source = next((line.split(None, 1)[1].strip() for line in path.read_text().splitlines()
                   if line.strip().startswith('FROM ')), '')
    if source.startswith('/models/'):
        return (root / source[8:]).exists()
    return True


def generate_models_ini():
    root = models_dir()
    ini_path = root / 'models.ini'
    lines = [
        "version = 1",
        "",
    ]
    for name, path in presets().items():
        content = path.read_text()
        model_src = None
        ctx = 65536
        draft_model = None
        draft_type = None
        batch = 512
        ubatch = 256
        threads = 8
        cpu_moe = 0
        moe_cache = 0
        n_gpu_layers = None

        for line in content.splitlines():
            line = line.strip()
            if line.startswith('FROM '):
                model_src = line.split(None, 1)[1].strip()
            if line.startswith('PARAMETER num_ctx'):
                try:
                    ctx = int(line.split()[2])
                except Exception:
                    pass
            if line.startswith('PARAMETER num_gpu'):
                try:
                    n_gpu_layers = int(line.split()[2])
                except Exception:
                    pass

        if 'muse-glimmer' in name:
            model_src = '/models/Muse-Glimmer-30B-KQuant-Dynamic-Q4_K_XL.gguf'
            draft_model = '/models/dflash-Muse-Glimmer-30B-Q4_K_M.gguf'
            draft_type = "draft-dflash"

        if not model_src:
            continue

        # Only include presets whose weights are actually in PAIN_MODELS_DIR.
        if model_src.startswith('/models/'):
            if not (root / model_src[8:]).exists():
                continue
        if draft_model and draft_model.startswith('/models/'):
            if not (root / draft_model[8:]).exists():
                continue

        lines.append(f"[{name}]")
        lines.append(f"model = {model_src}")
        if draft_model:
            lines.append(f"spec-draft-model = {draft_model}")
        if draft_type:
            lines.append(f"spec-type = {draft_type}")
        if n_gpu_layers is not None:
            lines.append(f"n-gpu-layers = {n_gpu_layers}")
        lines.append(f"ctx-size = {ctx}")
        lines.append("")

    ini_path.write_text('\n'.join(lines) + '\n')
    print(f'[PAIN] Generated router presets: {ini_path}', flush=True)


def sync_opencode():
    opencode_cfg = Path.home() / '.config' / 'opencode' / 'opencode.json'
    generate_models_ini()
    if not opencode_cfg.exists():
        return
    try:
        data = json.loads(opencode_cfg.read_text())
    except Exception as exc:
        print(f'[PAIN] Warning: Could not parse opencode.json: {exc}', file=sys.stderr)
        return

    provider = data.setdefault('provider', {}).setdefault('pain', {})
    models = provider.setdefault('models', {})

    for name, path in presets().items():
        content = path.read_text()
        # Don't advertise a local preset before its weights are on disk.
        if not preset_ready(path):
            continue
        ctx = 65536
        predict = 8192
        first_comment = ""
        for line in content.splitlines():
            line = line.strip()
            if line.startswith('#') and not first_comment and not line.startswith('# STAGE') and not line.startswith('# STAGING'):
                first_comment = line.lstrip('#').strip()
            if line.startswith('PARAMETER num_ctx'):
                try:
                    ctx = int(line.split()[2])
                except Exception:
                    pass
            if line.startswith('PARAMETER num_predict'):
                try:
                    predict = int(line.split()[2])
                except Exception:
                    pass

        display_name = first_comment if first_comment else name
        models[name] = {
            'name': f"{name} ({display_name})" if display_name != name else name,
            'tool_call': True,
            'reasoning': True,
            'limit': {
                'context': ctx,
                'output': predict
            }
        }

    opencode_cfg.write_text(json.dumps(data, indent=2) + '\n')
    print(f'[PAIN] OpenCode synced: {len(models)} models available under provider "pain"', flush=True)


def apply(name):
    available = presets()
    if name not in available:
        raise ValueError(f'Unknown preset {name}. Use ./ai presets.')
    container()
    modelfile_content = available[name].read_text()
    # Stream the checked-in file through stdin, avoiding host-path mounts/copies.
    compose_args = ['exec', '-T', 'engine', 'sh', '-c',
                    'f=$(mktemp); trap \'rm -f "$f"\' EXIT; cat > "$f"; '
                    'ollama create "$1" -f "$f"', 'sh', name]
    env = config()
    env['PAIN_BACKEND'] = backend()
    env['PAIN_MODELS_DIR'] = str(models_dir())
    subprocess.run([runtime(), 'compose',
                    '-f', str(ROOT / 'compose.yaml'), '-f',
                    str(ROOT / 'backends' / f'{backend()}.yaml'), *compose_args],
                   input=modelfile_content, text=True, env=env, cwd=ROOT, check=True)
    dedupe_ollama_import(name, modelfile_content)
    sync_opencode()


def find_ollama_manifest(store, name, tag='latest'):
    """Locate the manifest written by `ollama create` / `ollama pull`."""
    name = name.strip('/')
    candidates = []
    for root in (store / 'manifests-v2', store / 'manifests'):
        for host in ('ollama.com', 'registry.ollama.ai'):
            candidates.append(root / host / 'library' / name / tag)
            candidates.append(root / host / name / tag)
    for candidate in candidates:
        if candidate.exists():
            return candidate
    for root in (store / 'manifests-v2', store / 'manifests'):
        if root.exists():
            for candidate in root.rglob(tag):
                if str(candidate).endswith(f'/{name}/{tag}'):
                    return candidate
    return None


def ollama_model_layer(manifest):
    """Return the largest model layer described by an Ollama manifest."""
    if manifest is None:
        return None
    try:
        data = json.loads(manifest.read_text())
    except (OSError, ValueError):
        return None
    layers = [layer for layer in data.get('layers', [])
              if layer.get('mediaType') == 'application/vnd.ollama.image.model']
    return max(layers, key=lambda layer: layer.get('size', 0)) if layers else None


def try_hardlink(source, destination):
    """Host-side hardlink. Returns False when the filesystem refuses."""
    source, destination = Path(source), Path(destination)
    if source.stat().st_dev != destination.parent.stat().st_dev:
        return False
    tmp = destination.with_name(destination.name + '.pain-link')
    try:
        if tmp.exists():
            tmp.unlink()
        os.link(source, tmp)
        os.replace(tmp, destination)
        return True
    except OSError:
        if tmp.exists():
            tmp.unlink()
        return False


def dedupe_ollama_import(name, modelfile_content):
    """Replace Ollama's imported blob with a hardlink to the source GGUF."""
    source = next((line.split(None, 1)[1].strip()
                   for line in modelfile_content.splitlines()
                   if line.strip().startswith('FROM ')), '')
    if not source.startswith('/models/'):
        return
    path = models_dir() / source[8:]
    if not path.exists():
        return
    store = models_dir() / 'ollama'
    layer = ollama_model_layer(find_ollama_manifest(store, name))
    if not layer:
        print(f'[PAIN] Warning: no Ollama manifest layer for {name}; '
              'not deduplicating.', file=sys.stderr)
        return
    digest = layer.get('digest', '').split(':', 1)[-1]
    blob = store / 'blobs' / f'sha256-{digest}'
    if not blob.exists():
        print(f'[PAIN] Warning: Ollama blob {digest[:12]} is missing; '
              'not deduplicating.', file=sys.stderr)
        return
    if path.stat().st_size != blob.stat().st_size:
        print(f'[PAIN] Warning: size mismatch for {name}; not deduplicating.',
              file=sys.stderr)
        return
    if path.stat().st_ino == blob.stat().st_ino:
        return
    if not try_hardlink(path, blob):
        # The Ollama store is root-owned; link from inside the running engine.
        try:
            compose('exec', '-T', 'engine', 'sh', '-c', 'ln -f "$1" "$2"', 'sh',
                    source, f'/models/ollama/blobs/sha256-{digest}')
        except (OSError, subprocess.CalledProcessError):
            pass
    if path.stat().st_ino == blob.stat().st_ino:
        print(f'[PAIN] Deduplicated Ollama import for {name} (hardlink).')
    else:
        print(f'[PAIN] Warning: could not hardlink {name}; left the copy in place.',
              file=sys.stderr)


def model_filename(name):
    name = Path(name).name
    safe = ''.join(char if char.isalnum() or char in '._-' else '_' for char in name)
    if not safe.lower().endswith('.gguf'):
        safe += '.gguf'
    return safe or 'model.gguf'


def resolve_download(source):
    """Map a URL/HF source to (url, filename); return None for Ollama tags."""
    if source.startswith(('http://', 'https://')):
        path = urllib.parse.urlparse(source).path
        return source, path.rsplit('/', 1)[-1] or 'model.gguf'
    if source.startswith('hf.co/'):
        parts = source[len('hf.co/'):].split('/', 2)
        if len(parts) != 3:
            raise ValueError('Hugging Face sources are hf.co/<owner>/<repo>/<file>.gguf')
        repo, filename = '/'.join(parts[:2]), parts[2]
        return (f'https://huggingface.co/{repo}/resolve/main/{filename}',
                filename.rsplit('/', 1)[-1])
    if ':' in source:
        repo, _, filename = source.rpartition(':')
        if filename.lower().endswith('.gguf'):
            return (f'https://huggingface.co/{repo}/resolve/main/{filename}',
                    filename.rsplit('/', 1)[-1])
    if source.lower().endswith('.gguf') and source.count('/') >= 2:
        parts = source.split('/', 2)
        repo, filename = '/'.join(parts[:2]), parts[2]
        return (f'https://huggingface.co/{repo}/resolve/main/{filename}',
                filename.rsplit('/', 1)[-1])
    return None


def sha256_file(path):
    digest = hashlib.sha256()
    with Path(path).open('rb') as handle:
        for chunk in iter(lambda: handle.read(8 * 1024 * 1024), b''):
            digest.update(chunk)
    return digest.hexdigest()


class _SafeRedirect(urllib.request.HTTPRedirectHandler):
    """Drop the HF token when a redirect crosses hosts (for example to a CDN)."""

    def redirect_request(self, req, fp, code, msg, headers, newurl):
        new = super().redirect_request(req, fp, code, msg, headers, newurl)
        if new is not None:
            old_host = urllib.parse.urlparse(req.full_url).hostname
            new_host = urllib.parse.urlparse(newurl).hostname
            if new_host != old_host:
                new.headers.pop('Authorization', None)
                new.unredirected_hdrs.pop('Authorization', None)
        return new


def download_file(url, destination, expected_sha256=None, force=False):
    destination = Path(destination)
    if destination.exists() and not force:
        if expected_sha256:
            if sha256_file(destination).lower() != expected_sha256.lower():
                raise ValueError(f'{destination} exists but its SHA-256 does not match; '
                                 'use --force to replace it.')
            print(f'[PAIN] {destination} already exists and matches SHA-256.')
        else:
            print(f'[PAIN] {destination} already exists; use --force to replace it.')
        return destination
    part = destination.with_name(destination.name + '.part')
    offset = part.stat().st_size if part.exists() else 0
    headers = {'User-Agent': 'PAIN/1.0'}
    host = urllib.parse.urlparse(url).hostname or ''
    token = os.environ.get('HF_TOKEN') or config().get('HF_TOKEN')
    if token and (host == 'huggingface.co' or host.endswith('.huggingface.co')
                  or host.endswith('hf.co')):
        headers['Authorization'] = f'Bearer {token}'
    if offset:
        headers['Range'] = f'bytes={offset}-'
    request = urllib.request.Request(url, headers=headers)
    opener = urllib.request.build_opener(_SafeRedirect())
    try:
        response = opener.open(request, timeout=60)
    except urllib.error.HTTPError as exc:
        if exc.code == 416 and offset:
            response = None
        else:
            raise
    if response is not None:
        if getattr(response, 'status', 200) != 206:
            offset = 0
        total = None
        content_range = response.headers.get('Content-Range', '')
        if '/' in content_range:
            try:
                total = int(content_range.rsplit('/', 1)[1])
            except ValueError:
                total = None
        elif response.headers.get('Content-Length'):
            total = offset + int(response.headers['Content-Length'])
        done = offset
        started = last = time.monotonic()
        with part.open('ab' if offset else 'wb') as out:
            while True:
                chunk = response.read(1024 * 1024)
                if not chunk:
                    break
                out.write(chunk)
                done += len(chunk)
                now = time.monotonic()
                if now - last >= 0.5:
                    speed = (done - offset) / max(now - started, 0.001) / (1024 * 1024)
                    if total:
                        print(f'\r  {destination.name}: {100.0 * done / total:5.1f}%  '
                              f'{done / 1e9:.2f}/{total / 1e9:.2f} GB  '
                              f'{speed:5.1f} MiB/s', end='', flush=True)
                    else:
                        print(f'\r  {destination.name}: {done / 1e9:.2f} GB  '
                              f'{speed:5.1f} MiB/s', end='', flush=True)
                    last = now
        response.close()
        print()
        if total is not None and done != total:
            raise ValueError(f'incomplete download: {done} of {total} bytes')
    if not part.exists():
        raise ValueError('download produced no file')
    if expected_sha256 and sha256_file(part).lower() != expected_sha256.lower():
        part.unlink()
        raise ValueError(f'SHA-256 mismatch for {url}')
    os.replace(part, destination)
    print(f'[PAIN] {destination} ({destination.stat().st_size / 1e9:.2f} GB)')
    return destination


def pull_ollama(tag, name=None, force=False):
    store = models_dir() / 'ollama'
    store.mkdir(parents=True, exist_ok=True)
    image = config().get('PAIN_VULKAN_IMAGE', 'ollama/ollama:0.40.13')
    script = ('ollama serve >/tmp/ollama-serve.log 2>&1 & '
              'for i in $(seq 1 60); do ollama list >/dev/null 2>&1 && break; sleep 0.5; done; '
              'ollama pull "$1"')
    subprocess.run([runtime(), 'run', '--rm',
                    '-v', f'{models_dir()}:/models',
                    '-e', 'OLLAMA_MODELS=/models/ollama',
                    '--entrypoint', 'sh', image, '-c', script, 'sh', tag], check=True)
    model, _, version = tag.partition(':')
    layer = ollama_model_layer(find_ollama_manifest(store, model, version or 'latest'))
    if not layer:
        raise ValueError(f'pulled {tag}, but could not find its manifest layer')
    digest = layer.get('digest', '').split(':', 1)[-1]
    blob = store / 'blobs' / f'sha256-{digest}'
    if not blob.exists():
        raise ValueError(f'pulled {tag}, but blob {digest[:12]} is missing')
    destination = models_dir() / model_filename(
        name or tag.replace(':', '-').replace('/', '_'))
    if destination.exists() and not force:
        print(f'[PAIN] {destination} already exists; use --force to replace it.')
        return destination
    if try_hardlink(blob, destination):
        print(f'[PAIN] {destination} (hardlink to Ollama blob {digest[:12]})')
        return destination
    # The Ollama store is root-owned; link from inside a throwaway container.
    try:
        subprocess.run([runtime(), 'run', '--rm',
                        '-v', f'{models_dir()}:/models',
                        '--entrypoint', 'sh', image, '-c', 'ln -f "$1" "$2"', 'sh',
                        f'/models/ollama/blobs/sha256-{digest}',
                        f'/models/{destination.name}'], check=True)
    except (OSError, subprocess.CalledProcessError):
        pass
    if destination.exists() and blob.stat().st_ino == destination.stat().st_ino:
        print(f'[PAIN] {destination} (hardlink to Ollama blob {digest[:12]})')
    else:
        shutil.copy2(blob, destination)
        print(f'[PAIN] {destination} (copied from Ollama blob {digest[:12]})')
    return destination


def pull(source, name=None, sha256=None, force=False):
    resolved = resolve_download(source)
    if resolved:
        url, default_name = resolved
        result = download_file(url, models_dir() / model_filename(name or default_name),
                               expected_sha256=sha256, force=force)
    else:
        if sha256:
            raise ValueError('--sha256 only applies to URL and Hugging Face downloads.')
        result = pull_ollama(source, name=name, force=force)
    print(f'[PAIN] Preset source: FROM /models/{result.name}')
    return result


def rate(count, duration):
    return count * 1e9 / duration if duration else None


def host_telemetry():
    def read_int(path):
        try:
            return int(Path(path).read_text().strip())
        except (OSError, ValueError):
            return None
    telemetry = {}
    for hwmon in sorted(Path('/sys/class/hwmon').glob('hwmon*')):
        try:
            name = (hwmon / 'name').read_text().strip()
        except OSError:
            continue
        if name == 'amdgpu':
            ppt = read_int(hwmon / 'power1_average') or read_int(hwmon / 'power1_input')
            sclk = read_int(hwmon / 'freq1_input')
            temp = read_int(hwmon / 'temp1_input')
            if ppt is not None:
                telemetry['gpu_ppt_watts'] = round(ppt / 1e6, 2)
            if sclk is not None:
                telemetry['gpu_sclk_mhz'] = round(sclk / 1e6, 1)
            if temp is not None:
                telemetry['gpu_temp_c'] = round(temp / 1e3, 1)
        elif name == 'k10temp':
            temp = read_int(hwmon / 'temp1_input')
            if temp is not None:
                telemetry['cpu_temp_c'] = round(temp / 1e3, 1)
    for card in sorted(Path('/sys/class/drm').glob('card*/device')):
        gtt = read_int(card / 'mem_info_gtt_used')
        vram = read_int(card / 'mem_info_vram_used')
        if gtt is not None:
            telemetry['gtt_used_gib'] = round(gtt / (1024 ** 3), 2)
        if vram is not None:
            telemetry['vram_used_gib'] = round(vram / (1024 ** 3), 2)
    return telemetry


def host_value(path):
    try:
        return Path(path).read_text().strip()
    except OSError:
        return None


def benchmark(args):
    details = container()
    model = api('show', {'model': args.model})
    prompt = args.prompt.read_text()
    drafts = args.drafts or [None]
    batches = args.batches or [None]
    threads = getattr(args, 'threads', None) or [None]
    temperature = getattr(args, 'temperature', 0)
    destination = ROOT / 'benchmarks' / 'results' / (
        dt.datetime.now(dt.timezone.utc).strftime('%Y%m%dT%H%M%S.%fZ') + '.jsonl')
    destination.parent.mkdir(parents=True, exist_ok=True)
    metadata = {
        'model': args.model, 'model_details': model.get('details'),
        'model_parameters': model.get('parameters'),
        'model_template_sha256': hashlib.sha256(model.get('template', '').encode()).hexdigest(),
        'ollama': api('version'), 'backend': backend(),
        'image_id': details['Image'], 'image': details['Config']['Image'],
        'environment': [e for e in details['Config']['Env']
                        if e.startswith(('OLLAMA_', 'GGML_', 'HSA_', 'ROCR_', 'RADV_', 'ROCBLAS_'))],
        'prompt_path': str(args.prompt),
        'prompt_sha256': hashlib.sha256(prompt.encode()).hexdigest(),
        'platform_profile': host_value('/sys/firmware/acpi/platform_profile'),
        'note': args.note, 'think': args.think == 'on',
    }
    print(f'Results: {destination}\nSequential sweep; avoid other inference requests during this run.',
          flush=True)
    for draft, batch, thread in itertools.product(drafts, batches, threads):
        options = {'temperature': temperature, 'seed': 42, 'num_predict': args.tokens,
                   'num_ctx': args.context}
        if draft is not None:
            options['draft_num_predict'] = draft
        if batch is not None:
            options['num_batch'] = batch
        if thread is not None:
            options['num_thread'] = thread
        for repeat in range(args.repeats):
            # Unload before every pair to separate fresh and exact-repeat prompts.
            api('generate', {'model': args.model, 'keep_alive': 0, 'stream': False})
            for phase in ('fresh', 'repeat'):
                result = api('generate', {
                    'model': args.model, 'prompt': prompt, 'stream': False,
                    'think': args.think == 'on', 'keep_alive': '30m', 'options': options,
                })
                timing = {k: v for k, v in result.items()
                          if k.endswith(('_count', '_duration')) or k == 'done_reason'}
                generation = rate(result.get('eval_count', 0), result.get('eval_duration', 0))
                cached = result.get('prompt_eval_cached_count') or 0
                uncached = (max(0, result.get('prompt_eval_count', 0) - cached)
                            if 'prompt_eval_count' in result else None)
                pp_speed = (rate(uncached, result.get('prompt_eval_duration', 0))
                            if uncached is not None else None)
                telemetry = host_telemetry()
                record = {**metadata, 'options': options, 'repeat': repeat + 1,
                          'phase': phase, 'timing': timing,
                          'generation_tokens_per_second': generation,
                          'uncached_prompt_tokens_per_second': pp_speed,
                          'telemetry': telemetry,
                          'response': result.get('response'), 'thinking': result.get('thinking'),
                          'loaded_models': api('ps')}
                with destination.open('a') as out:
                    out.write(json.dumps(record) + '\n')
                tg_str = f'{generation:.2f}' if generation is not None else 'n/a'
                pp_str = f'{pp_speed:.2f}' if pp_speed is not None else 'n/a'
                print(f'draft={draft if draft is not None else "preset"} '
                      f'batch={batch or "preset"} thread={thread or "preset"} '
                      f'run={repeat + 1} {phase}: pp={pp_str} tok/s tg={tg_str} tok/s', flush=True)


def positive(value):
    value = int(value)
    if value <= 0:
        raise argparse.ArgumentTypeError('must be positive')
    return value


def nonnegative(value):
    value = int(value)
    if value < 0:
        raise argparse.ArgumentTypeError('must be zero or positive')
    return value


def lab_image_id():
    try:
        return subprocess.check_output(
            [runtime(), 'inspect', '-f', '{{.Id}}', 'pain-lab'], text=True).strip()
    except subprocess.CalledProcessError as exc:
        raise ValueError('Lab image not built. Run ./ai lab build first.') from exc


def code_git(code):
    """Best-effort git identity of the mounted code directory."""
    try:
        rev = subprocess.check_output(
            ['git', '-C', str(code), 'rev-parse', 'HEAD'],
            text=True, stderr=subprocess.DEVNULL).strip()
    except (OSError, subprocess.CalledProcessError):
        return None
    dirty = subprocess.run(
        ['git', '-C', str(code), 'diff', '--quiet'],
        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode != 0
    return {'rev': rev, 'dirty': dirty}


def lab_run_args(args, shell=False):
    cfg = config()
    code_raw = args.code or cfg.get('PAIN_LAB_CODE')
    if not code_raw:
        raise ValueError('Lab runs need --code DIR (or PAIN_LAB_CODE in .env).')
    code = Path(code_raw).expanduser().resolve()
    experiments = Path(cfg.get('PAIN_LAB_EXPERIMENTS', str(ROOT / 'experiments'))).expanduser().resolve()
    experiments.mkdir(parents=True, exist_ok=True)
    threads = getattr(args, 'threads', None) or cfg.get('PAIN_LAB_THREADS', '8')
    seed = getattr(args, 'seed', None) or cfg.get('PAIN_LAB_SEED', '0')
    argv = [runtime(), 'run', '--rm',
            '-v', f'{code}:/workspace/code',
            '-v', f'{experiments}:/workspace/experiments',
            '-v', 'pain-lab-data:/data',
            '-e', 'PYTHONHASHSEED=0',
            '-e', f'OMP_NUM_THREADS={threads}',
            '-e', f'MKL_NUM_THREADS={threads}',
            '-e', f'SEED={seed}',
            '-w', '/workspace/code']
    if shell:
        argv += ['-it', '--entrypoint', 'bash', 'pain-lab']
    else:
        if not args.cmd:
            raise ValueError('No command given for ./ai lab run.')
        # argparse REMAINDER can capture the literal '--' separator first.
        cmd = list(args.cmd)
        if cmd and cmd[0] == '--':
            cmd = cmd[1:]
        if not cmd:
            raise ValueError('No command given for ./ai lab run.')
        argv += ['pain-lab'] + cmd
    record = {'utc': dt.datetime.now(dt.timezone.utc).isoformat(),
              'command': argv,
              'image_id': lab_image_id(),
              'code_dir': str(code),
              'code_git': code_git(code),
              'threads': threads,
              'seed': seed,
              'hostname': socket.gethostname(),
              'platform_profile': host_value('/sys/firmware/acpi/platform_profile')}
    record['run_id'] = hashlib.sha256(
        (record['utc'] + json.dumps(record['command'])).encode()).hexdigest()[:12]
    return argv, record


def lab(args):
    if args.lab_command == 'build':
        subprocess.run([runtime(), 'build', '-t', 'pain-lab',
                        '-f', str(ROOT / 'lab' / 'Dockerfile'), str(ROOT / 'lab')], check=True)
        print(f'PAIN lab image ready: {lab_image_id()}')
        return
    if args.lab_command == 'ps':
        result = subprocess.run(
            [runtime(), 'ps', '--filter', 'ancestor=pain-lab',
             '--format', '{{.ID}}\t{{.RunningFor}}\t{{.Command}}'],
            capture_output=True, text=True, check=True)
        if not result.stdout.strip():
            print('No lab containers running.')
            return
        print('ID\tAGE\tCOMMAND')
        print(result.stdout, end='')
        return
    argv, record = lab_run_args(args, shell=(args.lab_command == 'shell'))
    if args.lab_command == 'shell':
        subprocess.run(argv, check=False)
        return
    print(f'[PAIN lab] image {record["image_id"]}', flush=True)
    print(f'[PAIN lab] code {record["code_dir"]} seed={record["seed"]} threads={record["threads"]}',
          flush=True)
    print(f'[PAIN lab] running: {" ".join(args.cmd)}', flush=True)
    started = time.monotonic()
    completed = subprocess.run(argv, check=False)
    record['exit_code'] = completed.returncode
    record['duration_s'] = round(time.monotonic() - started, 3)
    runs = ROOT / 'experiments' / 'lab_runs.jsonl'
    runs.parent.mkdir(parents=True, exist_ok=True)
    with runs.open('a') as out:
        out.write(json.dumps(record) + '\n')
    print(f'[PAIN lab] exit {completed.returncode}; provenance: {runs}', flush=True)
    if completed.returncode:
        raise ValueError(f'lab run failed with exit code {completed.returncode}')


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    sub = parser.add_subparsers(dest='command', required=True)
    p = sub.add_parser('up', help='Start or switch backend')
    p.add_argument('backend', choices=BACKENDS)
    for name in ('down', 'status', 'logs', 'presets', 'top', 'sync'):
        sub.add_parser(name)
    p = sub.add_parser('config', help='Render a backend Compose configuration')
    p.add_argument('backend', choices=BACKENDS)
    p = sub.add_parser('pull', help='Download a GGUF into PAIN_MODELS_DIR')
    p.add_argument('source',
                   help='HTTP(S) URL, hf.co/<owner>/<repo>/<file>.gguf, '
                        '<repo>:<file>.gguf, or an Ollama tag')
    p.add_argument('--name', help='Output filename (default: derived from the source)')
    p.add_argument('--sha256', help='Expected SHA-256 for file downloads')
    p.add_argument('--force', action='store_true', help='Replace an existing file')
    p = sub.add_parser('apply', help='Create a named model from a checked-in preset')
    p.add_argument('preset', choices=list(presets()))
    p = sub.add_parser('run', help='Chat with a model')
    p.add_argument('model')
    p.add_argument('--keepalive', default='30m')
    p = sub.add_parser('bench', help='Benchmark fresh/repeated prompts; save JSONL results')
    p.add_argument('model')
    p.add_argument('--prompt', type=Path, default=ROOT / 'benchmarks/prompts/code.txt')
    p.add_argument('--drafts', type=nonnegative, nargs='+')
    p.add_argument('--batches', type=positive, nargs='+')
    p.add_argument('--threads', type=positive, nargs='+')
    p.add_argument('--temperature', type=float, default=0)
    p.add_argument('--tokens', type=positive, default=256)
    p.add_argument('--context', type=positive, default=65536)
    p.add_argument('--repeats', type=positive, default=3)
    p.add_argument('--think', choices=('on', 'off'), default='off')
    p.add_argument('--note', default='', help='Record AC power, thermal conditions, etc.')
    p = sub.add_parser('lab', help='Run jobs in the pinned CPU training image')
    lab_sub = p.add_subparsers(dest='lab_command', required=True)
    p = lab_sub.add_parser('build', help='Build the lab image from lab/Dockerfile')
    p = lab_sub.add_parser('ps', help='List running lab containers')
    for name in ('run', 'shell'):
        p = lab_sub.add_parser(name,
                               help='Run a command / open a shell inside the lab image')
        p.add_argument('--code', help='Code directory mounted at /workspace/code '
                                      '(default: PAIN_LAB_CODE)')
        p.add_argument('--threads', help='OMP/MKL thread count (default: 8)')
        if name == 'run':
            p.add_argument('--seed', help='SEED environment value (default: 0)')
            p.add_argument('cmd', nargs=argparse.REMAINDER,
                           help='Command to run in the container (after all options)')
    args = parser.parse_args()
    if args.command == 'up':
        up(args.backend)
    elif args.command == 'config':
        compose('config', selected=args.backend)
    elif args.command == 'down':
        compose('down')
        RUNTIME_STATE.unlink(missing_ok=True)
        CONTAINER_STATE.unlink(missing_ok=True)
    elif args.command == 'logs':
        compose('logs', '-f', '--tail', '100', 'engine')
    elif args.command == 'status':
        compose('ps')
        if backend().startswith('llamacpp'):
            port = config().get('PAIN_PORT', '11434')
            with urllib.request.urlopen(f'http://127.0.0.1:{port}/models', timeout=10) as response:
                print(json.dumps(json.load(response), indent=2))
        else:
            print(json.dumps(api('ps'), indent=2))
    elif args.command == 'top':
        subprocess.run([sys.executable, str(ROOT / 'paintop')])
    elif args.command == 'sync':
        sync_opencode()
    elif args.command == 'presets':
        for name, path in presets().items():
            print(f'{name:32} {path.relative_to(ROOT)}')
    elif args.command == 'apply':
        apply(args.preset)
    elif args.command == 'pull':
        pull(args.source, name=args.name, sha256=args.sha256, force=args.force)
    elif args.command == 'run':
        container()
        compose('exec', 'engine', 'ollama', 'run', args.model,
                '--keepalive', args.keepalive)
    elif args.command == 'bench':
        benchmark(args)
    elif args.command == 'lab':
        lab(args)


if __name__ == '__main__':
    try:
        main()
    except KeyboardInterrupt:
        sys.exit(130)
    except (ValueError, OSError, subprocess.CalledProcessError) as exc:
        print(f'PAIN: {exc}', file=sys.stderr)
        sys.exit(1)
